# Required — set keys only for providers you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Model selection — use provider/model format.
# Bare names auto-resolve (claude-* → anthropic, gpt-* → openai).
WIKI_SELECTOR_MODEL=anthropic/claude-haiku-5-5
WIKI_ANSWERER_MODEL=anthropic/claude-sonnet-5-5

# Independent content review (python -m wiki_api.content_review); Anthropic models only.
# CONTENT_REVIEW_MODEL=claude-opus-5-5
# CONTENT_REVIEW_EFFORT=xhigh

# For local models via LM Studio (no API keys needed):
# WIKI_SELECTOR_MODEL=lmstudio/llama-3-8b
# WIKI_ANSWERER_MODEL=lmstudio/llama-3-8b
